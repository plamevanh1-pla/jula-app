  {
  "expo": {
    "name": "Jula",
    "slug": "jula",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#f57c00"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.julaapp.jula",
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "baseUrl": "/",
      "loadingIndicator": "static"
    },


    "typescript": {
      "tsconfigPath": "tsconfig.json"
    },
    "extra": {
      "eas": {
        "projectId": "2ded0a72-0735-44d8-85be-462a53b73411"
      }
    },
    "owner": "jula-jacky-dev"
  }
}
