   {
  "expo": {
    "name": "Jula",
    "slug": "jula",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#e65100"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.julaapp.jula",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#e65100"
      },
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "baseUrl": "/",
      "loadingIndicator": "static"
    },
    "extra": {
      "eas": {
        "projectId": "2ded0a72-0735-44d8-85be-462a53b73411"
      }
    },
    "owner": "jula-jacky-dev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://expo.dev"
    }
  }
}
